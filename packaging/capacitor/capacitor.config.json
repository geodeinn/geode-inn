{
  "appId": "com.geodeinn.arcade",
  "appName": "Geode Inn Arcade",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "backgroundColor": "#0a0a0f",
    "preferredContentMode": "fullscreen"
  },
  "android": {
    "backgroundColor": "#0a0a0f",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a0f",
      "showSpinner": false
    }
  }
}
