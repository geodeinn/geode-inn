  },
  {
    "dialogueId": "peruvian_guide_002",
    "lines": [
      "Blue opal. The mountain sweats it. The Andes weep stone tears \u2014 that is how the old ones described it.",
      "The opal carries water inside stone. The Inca believed it was the tears of Pachamama, frozen in the mountain's embrace.",
      "Run far enough, high enough, and the mountain will let you find one."
    ],
    "responses": [],
    "setFlags": [
      "learned_blue_opal"
    ],
    "questLink": "",
    "conditionTag": "",
    "priority": 1,
    "isWhisperLayer": false,
