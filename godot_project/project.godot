; Geode Inn — Main Game Project
; Engine version: Godot 4.3
; The Geode Inn: A living archive of stone, sound, and story
; Hub structure inspired by Ironforge: central forge (hearth) with corridors to named districts
; Steam release target
; Unified Control Spec: Switch 2 + Keyboard/Mouse + Touch

config_version=5

[application]

config/name="The Geode Inn"
config/description="A living archive of stone, sound, and story. Explore the Inn, play arcade games, collect stones, and discover the world's mythology."
run/main_scene="res://scenes/MainHub.tscn"
config/features=PoolStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/geode_inn_logo.png"

[autoload]

GameManager="*res://scripts/GameManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
SteamManager="*res://scripts/SteamManager.gd"
StoneLoader="*res://scripts/StoneLoader.gd"
DialogueManager="*res://scripts/DialogueManager.gd"
DialogueTrees="*res://scripts/DialogueTrees.gd"
MovementSystem="*res://scripts/MovementSystem.gd"
ZoneCollision="*res://scripts/ZoneCollision.gd"
SpriteLoader="*res://scripts/SpriteLoader.gd"
ControllerManager="*res://scripts/ControllerManager.gd"
OverlayManager="*res://scripts/OverlayManager.gd"
FrequencyShift="*res://scripts/FrequencyShift.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

; === MOVEMENT (Arrow keys + WASD) ===
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode",4194320,"unicode",0,"location",0,"echo",false,"pressed",false), Object(InputEventKey,"physical_keycode",87,"unicode",119,"location",0,"echo",false,"pressed",false)]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode",4194322,"unicode",0,"location",0,"echo",false,"pressed",false), Object(InputEventKey,"physical_keycode",83,"unicode",115,"location",0,"echo",false,"pressed",false)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode",4194319,"unicode",0,"location",0,"echo",false,"pressed",false), Object(InputEventKey,"physical_keycode",65,"unicode",97,"location",0,"echo",false,"pressed",false)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode",4194321,"unicode",0,"location",0,"echo",false,"pressed",false), Object(InputEventKey,"physical_keycode",68,"unicode",100,"location",0,"echo",false,"pressed",false)]
}

; === PRIMARY ACTIONS ===
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode",69,"unicode",101,"location",0,"echo",false,"pressed",false), Object(InputEventKey,"physical_keycode",70,"unicode",102,"location",0,"echo",false,"pressed",false)]
}
